# Path to local VLM model weights or HuggingFace model ID
VLM_MODEL_ID=ibm-granite/granite-vision-4.1-4b

# Device: cuda, mps, or cpu
VLM_DEVICE=cuda

# Maximum tokens for VLM output
VLM_MAX_NEW_TOKENS=1024

# Confidence threshold below which extraction is flagged for review
# Value between 0.0 and 1.0
CONFIDENCE_THRESHOLD=0.75

# Input and output directories
INPUT_DIR=./input
OUTPUT_DIR=./output
