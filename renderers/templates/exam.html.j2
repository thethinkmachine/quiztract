<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ exam_code }} Questions</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- KaTeX for math formulas -->
    <link rel="stylesheet" href="{{ katex_cdn }}/katex.min.css">
    <script defer src="{{ katex_cdn }}/katex.min.js"></script>
    <script defer src="{{ katex_cdn }}/contrib/auto-render.min.js" onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"></script>
    
    <style>
        :root {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --success: #10b981;
            --danger: #ef4444;
            --glass-bg: rgba(15, 23, 42, 0.8);
            --font-family: 'Inter', sans-serif;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.6;
            background-image: radial-gradient(circle at 50% -20%, #1e3a8a, var(--bg-color) 60%);
            background-attachment: fixed;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem;
            padding-top: 100px;
        }

        /* Glassmorphism Header */
        .header-nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border);
            z-index: 100;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .header-title {
            font-size: 1.25rem;
            font-weight: 700;
            background: linear-gradient(to right, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .controls {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        button {
            font-family: var(--font-family);
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 999px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
        }

        button:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--primary);
            color: #60a5fa;
        }

        .btn-outline:hover {
            background: rgba(59, 130, 246, 0.1);
        }

        .timer {
            font-family: monospace;
            font-size: 1.5rem;
            font-weight: 700;
            color: #fca5a5;
            display: none;
            text-shadow: 0 0 10px rgba(252, 165, 165, 0.3);
        }

        /* Question Cards */
        .question {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .question:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .question-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--card-border);
        }

        .badge {
            background: rgba(255,255,255,0.1);
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .marks-badge {
            background: rgba(16, 185, 129, 0.1);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .question-text {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }

        .options-list {
            list-style: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .option-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .option-item:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .option-item.selected {
            border-color: var(--primary);
            background: rgba(59, 130, 246, 0.1);
        }

        .option-label {
            background: rgba(255,255,255,0.1);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        /* Answer Section */
        .answer-section {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px dashed var(--card-border);
        }

        .hidden-answer {
            display: none;
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(16, 185, 129, 0.1);
            border-left: 4px solid var(--success);
            border-radius: 4px;
        }

        .metadata-toggle {
            font-size: 0.85rem;
            color: #94a3b8;
            cursor: pointer;
            margin-top: 1rem;
            display: inline-block;
        }

        .metadata-content {
            display: none;
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
            font-size: 0.85rem;
            color: #cbd5e1;
        }

        img { max-width: 100%; border-radius: 8px; margin: 1rem 0; border: 1px solid var(--card-border); }
        table { width: 100%; border-collapse: collapse; margin: 1rem 0; background: rgba(0,0,0,0.2); border-radius: 8px; overflow: hidden; }
        th, td { padding: 0.75rem 1rem; border: 1px solid var(--card-border); }
        th { background: rgba(255,255,255,0.05); font-weight: 600; }

        /* Results Modal */
        #results-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: var(--bg-color);
            border: 1px solid var(--card-border);
            padding: 3rem;
            border-radius: 16px;
            text-align: center;
            max-width: 400px;
            width: 90%;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
            animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes popIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .score-display {
            font-size: 4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #34d399, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 1rem 0;
        }
    </style>
</head>
<body>
    <div class="header-nav">
        <div class="header-title">{{ exam_code }}</div>
        <div class="controls">
            <div id="timer" class="timer">90:00</div>
            <button id="btn-mode" class="btn-outline" onclick="toggleMode()">Switch to Exam Mode</button>
            <button id="btn-submit" style="display:none;" onclick="submitExam()">Submit Exam</button>
        </div>
    </div>

    <div class="container">
        {% if not questions %}
            <p style="text-align:center; color:#94a3b8;">No questions found in this output.</p>
        {% else %}
            {% for q in questions %}
            {% set c_marks = q.get('metadata', {}).get('Correct Marks', '1') %}
            {% set n_marks = q.get('metadata', {}).get('Negative Marks', '0') %}
            <div class="question" id="q-{{ loop.index }}" data-correct="{{ q.get('correct_answer', '') | tojson | forceescape }}" data-cmarks="{{ c_marks }}" data-nmarks="{{ n_marks }}">
                <div class="question-header">
                    <div style="display:flex; gap: 1rem; align-items:center;">
                        <span style="font-weight:700; font-size:1.2rem;">Q{{ loop.index }}</span>
                        <span class="badge">{{ q.get('question_type', 'MCQ') }}</span>
                    </div>
                    <div style="display:flex; gap:0.5rem;">
                        <span class="badge marks-badge">+{{ c_marks }} / -{{ n_marks }}</span>
                    </div>
                </div>
                
                <div class="question-text">
                    {{ q.get('question_text', '') }}
                </div>
                
                {% if q.get('images') %}
                    {% for img in q.images %}
                        <img src="{{ img.local_path }}" alt="{{ img.get('description', 'Figure') }}">
                    {% endfor %}
                {% endif %}
                
                {% if q.get('tables') %}
                    {% for table in q.tables %}
                        <table>
                            {% if table.get('headers') %}
                            <thead><tr>{% for h in table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
                            {% endif %}
                            <tbody>
                                {% for row in table.get('rows', []) %}
                                <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endfor %}
                {% endif %}
                
                {% if q.get('options') %}
                <ul class="options-list">
                    {% for opt in q.options %}
                    {% set opt_label = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'][loop.index0] %}
                    <li class="option-item" onclick="selectOption(this, '{{ opt_label }}')">
                        <span class="option-label">{{ opt_label }}</span>
                        <span>{{ opt }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
                
                <div class="answer-section practice-only">
                    {% if q.get('correct_answer') %}
                    <button class="btn-outline" onclick="toggleAnswer(this)" style="font-size:0.85rem; padding:0.25rem 0.75rem;">Show Answer</button>
                    <div class="hidden-answer">
                        <strong>Correct Answer:</strong> {{ q.correct_answer }}
                    </div>
                    {% endif %}
                </div>

                {% if q.get('metadata') %}
                <div>
                    <div class="metadata-toggle" onclick="toggleMetadata(this)">► Show Metadata</div>
                    <div class="metadata-content">
                        <ul style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem;">
                            {% for k, v in q.metadata.items() %}
                                <li><span style="color:#64748b;">{{ k }}:</span> {{ v }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        {% endif %}
    </div>

    <div id="results-modal">
        <div class="modal-content">
            <h2 style="margin-top:0;">Exam Completed</h2>
            <div class="score-display" id="final-score">0.0</div>
            <p style="color:#94a3b8; margin-bottom:2rem;">Total Marks Scored</p>
            <button onclick="closeModal()" style="width:100%;">Review Answers</button>
        </div>
    </div>

    <script>
        let isExamMode = false;
        let timerInterval;
        let timeRemaining = 90 * 60; // 90 minutes in seconds

        function toggleMode() {
            isExamMode = !isExamMode;
            const btnMode = document.getElementById('btn-mode');
            const btnSubmit = document.getElementById('btn-submit');
            const timer = document.getElementById('timer');
            const practiceElements = document.querySelectorAll('.practice-only');

            if (isExamMode) {
                btnMode.textContent = "Exit Exam Mode";
                btnSubmit.style.display = "block";
                timer.style.display = "block";
                practiceElements.forEach(el => el.style.display = "none");
                startTimer();
                // Reset selections
                document.querySelectorAll('.option-item').forEach(el => el.classList.remove('selected'));
                document.querySelectorAll('.question').forEach(el => el.removeAttribute('data-selected'));
            } else {
                btnMode.textContent = "Switch to Exam Mode";
                btnSubmit.style.display = "none";
                timer.style.display = "none";
                practiceElements.forEach(el => el.style.display = "block");
                stopTimer();
                timeRemaining = 90 * 60;
                timer.textContent = "90:00";
                resetExamStyles();
            }
        }

        function selectOption(el, label) {
            const list = el.closest('.options-list');
            const question = el.closest('.question');
            const qType = question.querySelector('.badge').textContent.trim();
            
            if (qType === 'MSQ') {
                el.classList.toggle('selected');
                let selected = question.getAttribute('data-selected') || "";
                let selectedArr = selected ? selected.split(',') : [];
                if (el.classList.contains('selected')) {
                    selectedArr.push(label);
                } else {
                    selectedArr = selectedArr.filter(item => item !== label);
                }
                selectedArr.sort();
                question.setAttribute('data-selected', selectedArr.join(','));
            } else {
                // Single select for MCQ
                list.querySelectorAll('.option-item').forEach(item => item.classList.remove('selected'));
                el.classList.add('selected');
                question.setAttribute('data-selected', label);
            }
        }

        function toggleAnswer(btn) {
            const answerDiv = btn.nextElementSibling;
            if (answerDiv.style.display === "block") {
                answerDiv.style.display = "none";
                btn.textContent = "Show Answer";
            } else {
                answerDiv.style.display = "block";
                btn.textContent = "Hide Answer";
            }
        }

        function toggleMetadata(btn) {
            const metaDiv = btn.nextElementSibling;
            if (metaDiv.style.display === "block") {
                metaDiv.style.display = "none";
                btn.textContent = "► Show Metadata";
            } else {
                metaDiv.style.display = "block";
                btn.textContent = "▼ Hide Metadata";
            }
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                timeRemaining--;
                updateTimerDisplay();
                if (timeRemaining <= 0) {
                    submitExam();
                }
            }, 1000);
        }

        function stopTimer() {
            clearInterval(timerInterval);
        }

        function updateTimerDisplay() {
            const m = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
            const s = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('timer').textContent = `${m}:${s}`;
        }

        function submitExam() {
            stopTimer();
            let totalScore = 0;
            let questions = document.querySelectorAll('.question');
            
            questions.forEach(q => {
                const selected = q.getAttribute('data-selected');
                const correctStr = q.getAttribute('data-correct') || "null";
                let correctObj = null;
                try {
                    correctObj = JSON.parse(correctStr);
                } catch(e) {}
                
                let correctArr = [];
                if (Array.isArray(correctObj)) {
                    correctArr = correctObj.map(s => String(s).trim().charAt(0).toUpperCase());
                } else if (typeof correctObj === 'string') {
                    // Extract letters
                    const matches = correctObj.match(/[A-H]/g);
                    if (matches) {
                        correctArr = [...new Set(matches)]; // Unique letters
                    }
                }
                correctArr.sort();
                let correctFinal = correctArr.join(',');

                const cMarks = parseFloat(q.getAttribute('data-cmarks')) || 1;
                const nMarks = parseFloat(q.getAttribute('data-nmarks')) || 0;

                if (selected) {
                    if (selected === correctFinal && correctFinal !== "") {
                        totalScore += cMarks;
                        q.style.borderColor = "var(--success)";
                        q.style.boxShadow = "0 0 15px rgba(16, 185, 129, 0.2)";
                    } else {
                        totalScore -= nMarks;
                        q.style.borderColor = "var(--danger)";
                        q.style.boxShadow = "0 0 15px rgba(239, 68, 68, 0.2)";
                    }
                }
                
                // Show the answer section
                const practiceSect = q.querySelector('.practice-only');
                if(practiceSect) {
                    practiceSect.style.display = "block";
                    const hiddenAns = practiceSect.querySelector('.hidden-answer');
                    if(hiddenAns) hiddenAns.style.display = "block";
                    const btn = practiceSect.querySelector('button');
                    if(btn) btn.style.display = "none";
                }
            });

            document.getElementById('final-score').textContent = totalScore.toFixed(2);
            document.getElementById('results-modal').style.display = "flex";
            document.getElementById('btn-submit').style.display = "none";
            document.getElementById('timer').style.display = "none";
        }

        function closeModal() {
            document.getElementById('results-modal').style.display = "none";
        }

        function resetExamStyles() {
            document.querySelectorAll('.question').forEach(q => {
                q.style.borderColor = "var(--card-border)";
                q.style.boxShadow = "";
                const practiceSect = q.querySelector('.practice-only');
                if(practiceSect) {
                    const hiddenAns = practiceSect.querySelector('.hidden-answer');
                    if(hiddenAns) hiddenAns.style.display = "none";
                    const btn = practiceSect.querySelector('button');
                    if(btn) btn.style.display = "inline-block";
                    btn.textContent = "Show Answer";
                }
            });
        }
    </script>
</body>
</html>
